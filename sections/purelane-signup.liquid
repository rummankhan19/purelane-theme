{%- liquid
  assign anchor = section.settings.anchor_id | handleize | default: 'club'
  assign form_id = 'pl-signup-' | append: section.id
-%}
<section
  class="pl-section pl-signup-sec"
  id="{{ anchor }}"
  aria-labelledby="pl-signup-heading-{{ section.id }}"
  style="{% if section.settings.background != blank %}background: {{ section.settings.background }};{% endif %}"
>
  <div class="pl-wrap">
    <div class="pl-glass pl-signup pl-rv">
      {%- if section.settings.kicker != blank -%}
        <span class="pl-kicker">{{ section.settings.kicker | escape }}</span>
      {%- endif -%}
      <h2 class="pl-d2" id="pl-signup-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="pl-lede">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}

      {%- comment -%}
        Posts to Shopify's own customer endpoint: the email lands in Customers with
        marketing consent and the tags below, so the merchant can target it from
        Shopify Email or any marketing app. The prototype's form did nothing (onsubmit="return false").
      {%- endcomment -%}
      {%- form 'customer', id: form_id, class: 'pl-signup__form' -%}
        <input type="hidden" name="contact[tags]" value="{{ section.settings.tags | escape }}">
        {%- if form.posted_successfully? -%}
          <div class="pl-signup__msg pl-signup__msg--ok" role="status" tabindex="-1" autofocus>
            {{ section.settings.success_message }}
          </div>
        {%- else -%}
          <label class="pl-sr" for="{{ form_id }}-email">{{ section.settings.email_label | escape }}</label>
          <input
            id="{{ form_id }}-email"
            type="email"
            name="contact[email]"
            autocomplete="email"
            autocapitalize="off"
            spellcheck="false"
            placeholder="{{ section.settings.placeholder | escape }}"
            required
            {% if form.errors %}aria-invalid="true" aria-describedby="{{ form_id }}-error"{% endif %}
          >
          <button class="pl-btn pl-btn--primary" type="submit">{{ section.settings.button_label | escape }}</button>
          {%- if form.errors -%}
            <p class="pl-signup__msg pl-signup__msg--err" id="{{ form_id }}-error" role="alert">
              {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
            </p>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane: Club signup",
  "tag": "div",
  "class": "section pl-signup-wrapper",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Join the Purelane Club" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get ₹100 off your first bundle" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Plus first access to new launches and restocks." },
    { "type": "text", "id": "email_label", "label": "Email field label", "info": "Read by screen readers.", "default": "Email address" },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "your@email.com" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Get my ₹100 off" },
    {
      "type": "richtext", "id": "success_message", "label": "Message after signing up",
      "info": "Put the discount code here. Create it in Discounts first.",
      "default": "<p>You're in. Use code <strong>CLUB100</strong> at checkout.</p>"
    },
    { "type": "text", "id": "tags", "label": "Customer tags", "info": "Added to everyone who signs up here, comma separated.", "default": "newsletter,purelane-club" },
    {
      "type": "color_background", "id": "background", "label": "Background",
      "info": "Leave empty to show the page backdrop, so sections flow into each other."
    },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "club" }
  ],
  "presets": [{ "name": "Purelane: Club signup" }]
}
{% endschema %}
