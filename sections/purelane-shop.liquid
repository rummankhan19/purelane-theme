{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.products_to_show
  assign anchor = section.settings.anchor_id | handleize
-%}
<section
  class="pl-section pl-shop"
  {% if anchor != blank %}id="{{ anchor }}"{% endif %}
  aria-labelledby="pl-shop-heading-{{ section.id }}"
  style="background: {{ section.settings.background }}; --pl-cols: {{ section.settings.columns_desktop }};"
>
  <div class="pl-wrap">
    <div class="pl-panel-head pl-rv">
      {%- if section.settings.kicker != blank -%}
        <span class="pl-kicker">{{ section.settings.kicker | escape }}</span>
      {%- endif -%}
      <h2 class="pl-d2" id="pl-shop-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.show_rule -%}
        <div class="pl-rule" aria-hidden="true"><i></i>{% render 'icon-promise', icon: 'leaf' %}<i></i></div>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="pl-lede">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    <div class="pl-shelf">
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: limit -%}
          {% render 'purelane-product-card',
            product: product,
            index: forloop.index0,
            show_rating: section.settings.show_rating,
            label_off: section.settings.label_off,
            label_reviews: section.settings.label_reviews
          %}
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Editor onboarding state so an unconfigured section never looks broken {%- endcomment -%}
        {%- for i in (1..4) -%}
          <article class="pl-card pl-glass">
            <div class="pl-card__shot">{{ 'product-1' | placeholder_svg_tag: 'pl-card__img pl-card__img--placeholder' }}</div>
            <h3 class="pl-card__title">Choose a collection</h3>
            <div class="pl-card__pr"><strong>{{ 1999 | money }}</strong></div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane: Shop grid",
  "tag": "div",
  "class": "section pl-shop-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "checkbox",
      "id": "show_rule",
      "label": "Show leaf divider",
      "default": true
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "info": "Optional. Empty in the original design."
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show star rating",
      "info": "Reads the reviews.rating metafield (filled by most review apps), or custom.rating.",
      "default": true
    },
    {
      "type": "text",
      "id": "label_off",
      "label": "Discount label",
      "default": "off"
    },
    {
      "type": "text",
      "id": "label_reviews",
      "label": "Reviews label",
      "default": "reviews"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color_background",
      "id": "background",
      "label": "Background",
      "default": "linear-gradient(178deg, #f0fbf2 0%, #d9f2df 28%, #bde6c8 60%, #a2d9b6 100%)"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "Buttons linking to #shop scroll here. Keep unique on the page.",
      "default": "shop"
    }
  ],
  "presets": [
    {
      "name": "Purelane: Shop grid"
    }
  ]
}
{% endschema %}
