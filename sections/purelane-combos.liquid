{%- liquid
  assign combos = section.blocks | where: 'type', 'combo'
  assign anchor = section.settings.anchor_id | handleize
-%}
<section
  class="pl-section pl-combos"
  {% if anchor != blank %}id="{{ anchor }}"{% endif %}
  aria-labelledby="pl-combos-heading-{{ section.id }}"
  style="background: {{ section.settings.background }};"
>
  <div class="pl-wrap">
    <div class="pl-panel-head pl-rv">
      {%- if section.settings.kicker != blank -%}
        <span class="pl-kicker">{{ section.settings.kicker | escape }}</span>
      {%- endif -%}
      <h2 class="pl-d2" id="pl-combos-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      <div class="pl-rule" aria-hidden="true"><i></i>{% render 'icon-promise', icon: 'leaf' %}<i></i></div>
      {%- if section.settings.subheading != blank -%}
        <p class="pl-lede">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    <ul class="pl-comborail pl-rv" role="list">
      {%- for block in combos -%}
        {%- liquid
          assign cp = block.settings.combo_product
          assign items = block.settings.included_products
          assign tray_max = section.settings.tray_max
          assign title = block.settings.title | default: cp.title
          assign savings = 0
          if cp != blank and cp.compare_at_price > cp.price
            assign savings = cp.compare_at_price | minus: cp.price
          endif
          assign includes = block.settings.includes
          if includes == blank and cp != blank
            assign includes = cp.description | strip_html | truncatewords: 30
          endif
        -%}
        <li class="pl-glass pl-combo{% if block.settings.highlight %} pl-combo--best{% endif %}" {{ block.shopify_attributes }}>
          <div class="pl-combo__tray">
            {%- if block.settings.save_override != blank -%}
              <span class="pl-combo__save">{{ block.settings.save_override | escape }}</span>
            {%- elsif savings > 0 -%}
              <span class="pl-combo__save">{{ section.settings.you_save_label | escape }} {{ savings | money }}</span>
            {%- endif -%}
            {%- if block.settings.flag != blank -%}
              <span class="pl-combo__flag">{{ block.settings.flag | escape }}</span>
            {%- endif -%}

            {%- if items.count > 0 -%}
              <div class="pl-combo__stack">
                {%- for p in items limit: tray_max -%}
                  <span class="pl-combo__it">
                    {%- if p.featured_media -%}
                      {{ p.featured_media | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 120, 160', sizes: '60px', alt: p.title }}
                    {%- else -%}
                      <span class="pl-combo__tile" role="img" aria-label="{{ p.title | escape }}">{% render 'icon-promise', icon: 'leaf' %}</span>
                    {%- endif -%}
                    <span class="pl-combo__benefit">{{ p.metafields.custom.tagline.value | default: p.title | escape }}</span>
                  </span>
                  {%- unless forloop.last -%}<span class="pl-combo__plus" aria-hidden="true">+</span>{%- endunless -%}
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>

          <div class="pl-combo__body">
            <h3 class="pl-combo__title">{{ title | escape }}</h3>
            {%- if items.count > 0 -%}
              <div class="pl-combo__cnt">{{ items.count }} {{ section.settings.count_label | escape }}</div>
            {%- endif -%}
            {%- if includes != blank -%}
              <p class="pl-combo__inc">{{ includes | escape }}</p>
            {%- endif -%}
            {%- if cp != blank -%}
              <div class="pl-combo__prow">
                <strong>{{ cp.price | money }}</strong>
                {%- if savings > 0 -%}
                  <s><span class="pl-sr">Regular price</span>{{ cp.compare_at_price | money }}</s>
                  <em>{{ section.settings.save_label | escape }} {{ savings | money }}</em>
                {%- endif -%}
              </div>
            {%- else -%}
              <p class="pl-combo__inc">Pick a combo product for this card.</p>
            {%- endif -%}
            {%- if section.settings.fine_print != blank -%}
              <div class="pl-combo__fine">{{ section.settings.fine_print | escape }}</div>
            {%- endif -%}
            <a class="pl-btn pl-btn--ghost" href="{{ block.settings.button_link | default: cp.url | default: '#' }}">
              {{ section.settings.button_label | escape }}
              {% render 'icon-arrow' %}
              <span class="pl-sr">: {{ title | escape }}</span>
            </a>
          </div>
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.swipe_cue != blank -%}
      <div class="pl-swipecue" aria-hidden="true">{% render 'icon-arrow' %}{{ section.settings.swipe_cue | escape }}</div>
    {%- endif -%}
    {%- if section.settings.rail_note != blank -%}
      <p class="pl-railnote">{{ section.settings.rail_note | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Purelane: Combos",
  "tag": "div",
  "class": "section pl-combos-wrapper",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Pre-built to save you money" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best selling combos" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own." },
    { "type": "range", "id": "tray_max", "label": "Products shown in each tray", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "text", "id": "count_label", "label": "Count label", "default": "products" },
    { "type": "text", "id": "you_save_label", "label": "Savings pill label", "default": "You save" },
    { "type": "text", "id": "save_label", "label": "Price savings label", "default": "Save" },
    { "type": "text", "id": "fine_print", "label": "Fine print", "default": "Inclusive of all taxes · COD available" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop bundle" },
    { "type": "text", "id": "swipe_cue", "label": "Swipe hint", "default": "Swipe for more combos" },
    { "type": "textarea", "id": "rail_note", "label": "Note under the rail", "default": "Tapping \"Shop bundle\" opens the bundle picker with these products already added. You can still swap anything before you pay." },
    {
      "type": "color_background", "id": "background", "label": "Background",
      "default": "linear-gradient(178deg, #f0fbf2 0%, #d9f2df 28%, #bde6c8 60%, #a2d9b6 100%)"
    },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "combos" }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo",
      "settings": [
        { "type": "product", "id": "combo_product", "label": "Combo product", "info": "Price, compare-at price and savings come from this product." },
        { "type": "product_list", "id": "included_products", "label": "Products in this combo", "limit": 6, "info": "Each shows its image and its Tagline metafield." },
        { "type": "text", "id": "title", "label": "Title override", "info": "Leave blank to use the combo product's title." },
        { "type": "textarea", "id": "includes", "label": "Description override", "info": "Leave blank to use the combo product's description." },
        { "type": "text", "id": "flag", "label": "Corner flag", "info": "E.g. Most popular, Best value." },
        { "type": "text", "id": "save_override", "label": "Savings pill override", "info": "E.g. Biggest saving. Leave blank to show the calculated amount." },
        { "type": "checkbox", "id": "highlight", "label": "Highlight this combo", "default": false },
        { "type": "url", "id": "button_link", "label": "Button link", "info": "Leave blank to link to the combo product." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane: Combos",
      "blocks": [
        { "type": "combo", "settings": { "flag": "Most popular" } },
        { "type": "combo" },
        { "type": "combo", "settings": { "flag": "Best value", "save_override": "Biggest saving", "highlight": true } },
        { "type": "combo" },
        { "type": "combo" }
      ]
    }
  ]
}
{% endschema %}
