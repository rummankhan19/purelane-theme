{%- comment -%}
  Replaces Dawn's footer in the footer group. Link columns are real Shopify
  menus (Content > Menus), contact details are settings, and the bottom row
  lists the store's actual policy pages from Settings > Policies.
{%- endcomment -%}
<footer class="pl-section pl-footer" style="{% if section.settings.background != blank %}background: {{ section.settings.background }};{% endif %}">
  <div class="pl-wrap">
    <div class="pl-footer__grid">
      {%- for block in section.blocks -%}
        <div class="pl-footer__col" {{ block.shopify_attributes }}>
          {%- case block.type -%}
            {%- when 'brand' -%}
              <a class="pl-footer__brand" href="{{ routes.root_url }}">
                {%- if settings.logo != blank -%}
                  {%- assign logo_w = settings.logo.aspect_ratio | times: 40 | round -%}
                  {{ settings.logo | image_url: width: 400 | image_tag: height: 40, width: logo_w, alt: shop.name, loading: 'lazy' }}
                {%- else -%}
                  <span class="pl-footer__name">{{ shop.name | escape }}</span>
                {%- endif -%}
              </a>
              {%- if block.settings.text != blank -%}
                <p>{{ block.settings.text | escape }}</p>
              {%- endif -%}

            {%- when 'menu' -%}
              {%- assign menu = linklists[block.settings.menu] -%}
              <h2 class="pl-footer__h">{{ block.settings.heading | default: menu.title | escape }}</h2>
              {%- if menu.links.size > 0 -%}
                <ul role="list">
                  {%- for link in menu.links -%}
                    <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}

            {%- when 'contact' -%}
              <h2 class="pl-footer__h">{{ block.settings.heading | escape }}</h2>
              <ul role="list">
                {%- if block.settings.email != blank -%}
                  <li><a href="mailto:{{ block.settings.email | escape }}">{{ block.settings.email | escape }}</a></li>
                {%- endif -%}
                {%- if block.settings.phone != blank -%}
                  <li><a href="tel:{{ block.settings.phone | remove: ' ' | escape }}">{{ block.settings.phone | escape }}</a></li>
                {%- endif -%}
              </ul>
              {%- if block.settings.company != blank -%}
                <p class="pl-footer__small">{{ block.settings.company | escape }}</p>
              {%- endif -%}
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="pl-footer__bot">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.legal_name | default: shop.name | escape }}</span>
      {%- if shop.policies.size > 0 -%}
        <ul class="pl-footer__policies" role="list">
          {%- for policy in shop.policies -%}
            <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Purelane: Footer",
  "tag": "div",
  "class": "section pl-footer-wrapper",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "legal_name", "label": "Legal name", "info": "Shown after the copyright year. Blank uses the store name.", "default": "Purelane Eco Products Private Limited" },
    {
      "type": "color_background", "id": "background", "label": "Background", "info": "Leave empty to show the page backdrop, so sections flow into each other."
    }
  ],
  "blocks": [
    {
      "type": "brand", "name": "Brand", "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Uses the logo from Theme settings > Logo." },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Effective cleaning, powered by nature. Made for Indian homes since day one." }
      ]
    },
    {
      "type": "menu", "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "info": "Blank uses the menu's name." },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "contact", "name": "Contact", "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Get in touch" },
        { "type": "text", "id": "email", "label": "Email", "default": "hello@purelane.com" },
        { "type": "text", "id": "phone", "label": "Phone", "default": "+91 9930 123 234" },
        { "type": "text", "id": "company", "label": "Company line", "default": "Purelane Eco Products Pvt Ltd" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane: Footer",
      "blocks": [
        { "type": "brand" },
        { "type": "menu", "settings": { "heading": "Shop", "menu": "main-menu" } },
        { "type": "menu", "settings": { "heading": "About", "menu": "footer" } },
        { "type": "contact" }
      ]
    }
  ]
}
{% endschema %}
